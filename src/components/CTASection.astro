---
const whatsappUrl =
  'https://wa.me/6281234567890?text=Halo%20Karya%20Agung%20Interior,%20saya%20ingin%20konsultasi%20untuk%20pengerjaan%20interior.%20Saya%20ingin%20kirim%20ukuran%20ruangan%20dan%20referensi%20desain.';
---

<section class="bg-emerald-950 px-6 py-20 text-white">
  <div class="mx-auto max-w-4xl text-center">
    <p class="text-sm font-semibold uppercase tracking-[0.3em] text-emerald-200">
      Mulai Diskusi
    </p>

    <h2 class="mt-4 text-3xl font-bold tracking-tight md:text-5xl">
      Ingin membuat kitchen set, kabinet, atau wall panel?
    </h2>

    <p class="mx-auto mt-5 max-w-2xl leading-8 text-emerald-50/80">
      Kirim ukuran ruangan, foto lokasi, atau referensi desain yang Anda suka.
      Kami bantu cek kebutuhan, pilihan material, dan estimasi awal yang paling masuk akal.
    </p>

    <div class="mx-auto mt-8 grid max-w-2xl gap-3 text-left sm:grid-cols-3">
      <div class="rounded-2xl bg-white/10 p-4">
        <p class="text-sm font-semibold text-white">1. Kirim Foto</p>
        <p class="mt-2 text-sm leading-6 text-emerald-50/70">
          Foto area yang ingin dibuat interior.
        </p>
      </div>

      <div class="rounded-2xl bg-white/10 p-4">
        <p class="text-sm font-semibold text-white">2. Kirim Ukuran</p>
        <p class="mt-2 text-sm leading-6 text-emerald-50/70">
          Ukuran kasar ruangan atau kabinet.
        </p>
      </div>

      <div class="rounded-2xl bg-white/10 p-4">
        <p class="text-sm font-semibold text-white">3. Kirim Referensi</p>
        <p class="mt-2 text-sm leading-6 text-emerald-50/70">
          Contoh desain atau style yang disukai.
        </p>
      </div>
    </div>

    <a
      href={whatsappUrl}
      target="_blank"
      class="mt-8 inline-flex rounded-full bg-white px-6 py-3 text-sm font-semibold text-emerald-950 transition hover:bg-emerald-50"
    >
      Konsultasi via WhatsApp
    </a>
  </div>
</section>