---
import { site } from '../data/site';

const whatsappUrl = `https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent(
  'Halo Karya Agung Interior, saya ingin cek estimasi kitchen set/kabinet custom. Berikut foto area, ukuran kasar, dan referensi yang saya suka.'
)}`;

const { variant = 'cards' } = Astro.props;
const isSimple = variant === 'simple';
---

<section class="bg-slate-950 px-6 py-20 text-white">
  <div class="mx-auto max-w-4xl text-center">
    <p class="text-sm font-semibold uppercase tracking-[0.3em] text-slate-300">
      Mulai Diskusi
    </p>

    <h2 class="mt-4 text-3xl font-bold tracking-tight md:text-5xl">
      Ingin membuat kitchen set, wardrobe, kabinet, atau wall panel?
    </h2>

    <p class="mx-auto mt-5 max-w-2xl leading-8 text-slate-300">
      Kirim foto area, ukuran kasar, dan referensi kabinet yang Anda suka.
      Kami bantu cek kebutuhan, pilihan material, dan estimasi awal sebelum
      survey atau produksi.
    </p>

    {isSimple ? (
      <p class="mx-auto mt-6 max-w-2xl text-sm leading-7 text-slate-300">
        Untuk estimasi awal, cukup kirim foto area, ukuran kasar, dan referensi
        kabinet yang Anda suka.
      </p>
    ) : (
      <div class="mx-auto mt-8 grid max-w-2xl gap-3 text-left sm:grid-cols-3">
        <div class="rounded-2xl bg-white/10 p-4">
          <p class="text-sm font-semibold text-white">1. Kirim Foto</p>
          <p class="mt-2 text-sm leading-6 text-slate-300">
            Foto area yang ingin dibuat kitchen set atau kabinet.
          </p>
        </div>

        <div class="rounded-2xl bg-white/10 p-4">
          <p class="text-sm font-semibold text-white">2. Kirim Ukuran</p>
          <p class="mt-2 text-sm leading-6 text-slate-300">
            Ukuran kasar ruangan atau kabinet.
          </p>
        </div>

        <div class="rounded-2xl bg-white/10 p-4">
          <p class="text-sm font-semibold text-white">3. Kirim Referensi</p>
          <p class="mt-2 text-sm leading-6 text-slate-300">
            Contoh kabinet, finishing, atau style yang disukai.
          </p>
        </div>
      </div>
    )}

    <a
      href={whatsappUrl}
      target="_blank"
      class="mt-8 inline-flex rounded-full bg-white px-6 py-3 text-sm font-semibold text-slate-950 transition hover:bg-slate-100"
    >
      Konsultasi via WhatsApp
    </a>
  </div>
</section>
