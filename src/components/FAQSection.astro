---
import { faqs } from '../data/faqs';
---

<section id="faq" class="bg-white px-6 py-20">
  <div class="mx-auto max-w-4xl">
    <p class="text-sm font-semibold uppercase tracking-[0.3em] text-slate-900">
      FAQ
    </p>

    <h2 class="mt-4 text-3xl font-bold tracking-tight text-slate-950 md:text-4xl">
      Pertanyaan sebelum membuat kitchen set atau kabinet custom.
    </h2>

    <p class="mt-5 max-w-2xl text-slate-600">
      Bagian ini membantu Anda memahami harga, material, survey, proses produksi,
      dan pemasangan sebelum konsultasi via WhatsApp.
    </p>

    <div class="mt-10 space-y-4">
      {faqs.map((faq) => (
        <div class="rounded-3xl border border-slate-200 bg-slate-50 p-6">
          <h3 class="font-semibold text-slate-950">{faq.question}</h3>
          <p class="mt-3 leading-7 text-slate-600">
            {faq.answer}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
