---
import { faqs } from '../data/faqs';
---

<section id="faq" class="bg-white px-6 py-20">
  <div class="mx-auto max-w-4xl">
    <p class="text-sm font-semibold uppercase tracking-[0.3em] text-emerald-700">
      FAQ
    </p>

    <h2 class="mt-4 text-3xl font-bold tracking-tight md:text-4xl">
      Pertanyaan yang sering muncul.
    </h2>

    <div class="mt-10 space-y-4">
      {faqs.map((faq) => (
        <div class="rounded-3xl border border-stone-200 bg-stone-50 p-6">
          <h3 class="font-semibold">{faq.question}</h3>
          <p class="mt-3 text-stone-600">
            {faq.answer}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>