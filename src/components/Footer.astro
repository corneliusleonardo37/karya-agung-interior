---
import { site } from '../data/site';
---

<footer class="bg-black px-6 py-12 text-slate-300">
  <div class="mx-auto grid max-w-6xl gap-8 md:grid-cols-3">
    <div class="text-center">
      <img
        src="/karya-agung-logo-putih.svg"
        alt="Karya Agung Interior logo"
        class="mx-auto h-20 w-auto"
      />

      <p class="mx-auto mt-4 max-w-sm text-sm leading-7 text-slate-400">
        Karya Agung Interior adalah spesialis kitchen set, kabinet custom,
        wardrobe, wall panel, backdrop TV, dan built-in furniture untuk rumah
        dan area usaha.
      </p>

      <p class="mx-auto mt-3 max-w-sm text-xs leading-6 text-slate-500">
        {site.legalName}
      </p>
    </div>

    <div>
      <h3 class="font-semibold text-white">Area Layanan</h3>
      <ul class="mt-4 space-y-2 text-sm text-slate-400">
        {site.areas.map((area) => (
          <li>{area}</li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="font-semibold text-white">Kontak</h3>
      <ul class="mt-4 space-y-2 text-sm text-slate-400">
        <li>WhatsApp: {site.whatsappDisplay}</li>
        <li>Instagram: {site.instagram}</li>
        <li>Email: {site.email}</li>
        <li>
          <a href="/estimasi-harga" class="transition hover:text-white">
            Estimasi Harga
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="mx-auto mt-10 max-w-6xl border-t border-slate-900 pt-6 text-center text-sm text-slate-500 md:text-left">
    Copyright 2026 {site.name}. All rights reserved.
  </div>
</footer>
