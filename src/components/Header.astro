---
import { whatsappUrl } from '../data/site';

const currentPath = Astro.url.pathname;

const navItems = [
  {
    label: 'Layanan',
    href: '/layanan',
    isActive: currentPath === '/layanan',
  },
  {
    label: 'Proses',
    href: '/#proses',
    isActive: false,
  },
  {
    label: 'Portfolio',
    href: '/portfolio',
    isActive: currentPath === '/portfolio',
  },
  {
    label: 'FAQ',
    href: '/#faq',
    isActive: false,
  },
  {
    label: 'Kontak',
    href: '/kontak',
    isActive: currentPath === '/kontak',
  },
];
---

<header class="fixed left-0 top-0 z-50 w-full border-b border-slate-200/70 bg-white/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-3">
    <a href="/" class="flex items-center gap-3 font-bold tracking-tight text-slate-950">
      <img
        src="/karya-agung-logo.svg"
        alt="Karya Agung Interior logo"
        class="h-18 w-auto"
      />
    </a>

    <nav class="hidden items-center gap-8 text-sm font-medium text-slate-700 md:flex">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            'transition hover:text-slate-950',
            item.isActive ? 'font-bold text-slate-950' : 'text-slate-700',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <a
      href={whatsappUrl}
      target="_blank"
      class="hidden rounded-full bg-slate-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-slate-950 md:inline-flex"
    >
      WhatsApp
    </a>

    <button
      id="mobile-menu-button"
      type="button"
      class="rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-800 md:hidden"
      aria-label="Buka menu navigasi"
      aria-expanded="false"
    >
      Menu
    </button>
  </div>

  <div
    id="mobile-menu"
    class="hidden border-t border-slate-200 bg-white px-6 py-4 md:hidden"
  >
    <nav class="mx-auto flex max-w-6xl flex-col gap-4 text-sm font-medium">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            'transition hover:text-slate-950',
            item.isActive ? 'font-bold text-slate-950' : 'text-slate-700',
          ]}
        >
          {item.label}
        </a>
      ))}

      <a
        href={whatsappUrl}
        target="_blank"
        class="mt-2 rounded-full bg-slate-900 px-4 py-3 text-center font-semibold text-white transition hover:bg-slate-950"
      >
        Konsultasi via WhatsApp
      </a>
    </nav>
  </div>
</header>

<script>
  const menuButton = document.querySelector('#mobile-menu-button');
  const mobileMenu = document.querySelector('#mobile-menu');

  menuButton?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');

    const isOpen = !mobileMenu?.classList.contains('hidden');
    menuButton.setAttribute('aria-expanded', String(isOpen));
    menuButton.textContent = isOpen ? 'Tutup' : 'Menu';
  });
</script>