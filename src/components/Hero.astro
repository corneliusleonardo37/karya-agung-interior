---
const whatsappUrl =
  'https://wa.me/6281331874471?text=Halo%20Karya%20Agung%20Interior,%20saya%20ingin%20konsultasi%20untuk%20pengerjaan%20interior.';
---

<section
  class="relative min-h-screen overflow-hidden bg-slate-950 bg-cover bg-center"
  style="background-image: linear-gradient(rgba(15, 23, 42, 0.72), rgba(15, 23, 42, 0.58)), url('/hero-installasi-kitchen-set.png');"
>
  <div class="relative z-10 mx-auto flex min-h-screen max-w-6xl flex-col justify-center px-6 pb-20 pt-32">
    <p class="mb-4 text-sm font-semibold uppercase tracking-[0.3em] text-slate-200">
      Karya Agung Interior
    </p>

    <h1 class="max-w-4xl text-4xl font-bold leading-tight tracking-tight text-white md:text-6xl">
      Interior Rumah yang Lebih Rapi, Fungsional, dan Nyaman Digunakan
    </h1>

    <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-200">
      Karya Agung Interior membantu pengerjaan kitchen set, kabinet custom, wall panel,
      dan interior rumah dengan proses yang jelas dari desain, produksi, hingga pemasangan.
    </p>

    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a
        href={whatsappUrl}
        target="_blank"
        class="rounded-full bg-white px-6 py-3 text-center text-sm font-semibold text-slate-950 transition hover:bg-slate-100"
      >
        Konsultasi via WhatsApp
      </a>

      <a
        href="#portfolio"
        class="rounded-full border border-white/40 bg-white/10 px-6 py-3 text-center text-sm font-semibold text-white backdrop-blur transition hover:bg-white/20"
      >
        Lihat Portfolio
      </a>
    </div>
  </div>
</section>