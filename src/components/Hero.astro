---
const whatsappUrl =
  'https://wa.me/6281234567890?text=Halo%20Karya%20Agung%20Interior,%20saya%20ingin%20konsultasi%20untuk%20pengerjaan%20interior.';
---

<section class="mx-auto flex min-h-screen max-w-6xl flex-col justify-center px-6 pb-20 pt-32">
  <p class="mb-4 text-sm font-semibold uppercase tracking-[0.3em] text-slate-900">
    Karya Agung Interior
  </p>

  <h1 class="max-w-4xl text-4xl font-bold leading-tight tracking-tight text-slate-950 md:text-6xl">
    Interior Rumah yang Lebih Rapi, Fungsional, dan Nyaman Digunakan
  </h1>

  <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600">
    Karya Agung Interior membantu pengerjaan kitchen set, kabinet custom, wall panel,
    dan interior rumah dengan proses yang jelas dari desain, produksi, hingga pemasangan.
  </p>

  <div class="mt-8 flex flex-col gap-3 sm:flex-row">
    <a
      href={whatsappUrl}
      target="_blank"
      class="rounded-full bg-slate-900 px-6 py-3 text-center text-sm font-semibold text-white transition hover:bg-slate-950"
    >
      Konsultasi via WhatsApp
    </a>

    <a
      href="#portfolio"
      class="rounded-full border border-slate-300 px-6 py-3 text-center text-sm font-semibold text-slate-800 transition hover:bg-slate-50"
    >
      Lihat Portfolio
    </a>
  </div>
</section>