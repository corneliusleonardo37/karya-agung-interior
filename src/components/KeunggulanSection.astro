const strengths = [
  {
    title: 'Spesialis Kabinet',
    description:
      'Berpengalaman mengerjakan kitchen set, lemari, storage, backdrop TV, dan furniture custom untuk kebutuhan rumah.',
  },
  {
    title: 'Ukuran Mengikuti Ruang',
    description:
      'Setiap pekerjaan menyesuaikan kondisi asli di lapangan, supaya hasil lebih pas, rapi, dan nyaman digunakan.',
  },
  {
    title: 'Material Bisa Disesuaikan',
    description:
      'Pilihan material dapat disesuaikan dengan kebutuhan, area penggunaan, tampilan yang diinginkan, dan budget.',
  },
  {
    title: 'Proses Lebih Jelas',
    description:
      'Mulai dari konsultasi, survey, desain, estimasi biaya, produksi, sampai pemasangan dibuat lebih mudah dipahami.',
  },
  {
    title: 'Cocok untuk Rumah Harian',
    description:
      'Fokus kami bukan hanya tampilan, tapi juga fungsi: penyimpanan cukup, mudah dibersihkan, dan nyaman dipakai setiap hari.',
  },
  {
    title: 'Komunikasi Langsung',
    description:
      'Kebutuhan, revisi, dan progres pekerjaan bisa didiskusikan dengan lebih jelas selama proses berjalan.',
