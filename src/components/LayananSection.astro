---
import { services } from '../data/services';
---

<section id="layanan" class="bg-white px-6 py-20">
  <div class="mx-auto max-w-6xl">
    <p class="text-sm font-semibold uppercase tracking-[0.3em] text-slate-900">
      Layanan
    </p>

    <h2 class="mt-4 max-w-3xl text-3xl font-bold tracking-tight text-slate-950 md:text-4xl">
      Layanan cabinetry custom untuk rumah dan area usaha.
    </h2>

    <p class="mt-5 max-w-2xl text-slate-600">
      Kami fokus pada pembuatan kabinet dan furniture built-in yang menyesuaikan
      ukuran ruang, kebutuhan penyimpanan, pilihan material, dan budget.
    </p>

    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {services.map((service) => (
        <div class="rounded-3xl border border-slate-200 bg-slate-50 p-6 transition hover:-translate-y-1 hover:bg-white hover:shadow-sm">
          <h3 class="text-xl font-semibold text-slate-950">{service.title}</h3>
          <p class="mt-3 leading-7 text-slate-600">
            {service.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
