---
import { services } from '../data/services';
---

<section id="layanan" class="bg-white px-6 py-20">
  <div class="mx-auto max-w-6xl">
    <p class="text-sm font-semibold uppercase tracking-[0.3em] text-emerald-700">
      Layanan
    </p>

    <h2 class="mt-4 max-w-3xl text-3xl font-bold tracking-tight md:text-4xl">
      Layanan desain dan pengelolaan proyek interior yang lebih rapi.
    </h2>

    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {services.map((service) => (
        <div class="rounded-3xl border border-stone-200 bg-stone-50 p-6">
          <h3 class="text-xl font-semibold">{service.title}</h3>
          <p class="mt-3 text-stone-600">
            {service.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>