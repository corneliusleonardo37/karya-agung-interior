---
import { portfolioItems } from '../data/portfolio';
---

<section id="portfolio" class="bg-slate-50 px-6 py-20">
  <div class="mx-auto max-w-6xl">
    <p class="text-sm font-semibold uppercase tracking-[0.3em] text-slate-900">
      Portfolio
    </p>

    <h2 class="mt-4 max-w-3xl text-3xl font-bold tracking-tight text-slate-950 md:text-4xl">
      Contoh pengerjaan kitchen set, kabinet custom, dan built-in furniture.
    </h2>

    <p class="mt-5 max-w-2xl text-slate-600">
      Beberapa contoh pekerjaan kami meliputi kitchen set, kabinet storage,
      wardrobe, backdrop TV, wall panel, dan kabinet display yang dibuat
      menyesuaikan ukuran ruang.
    </p>

    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {portfolioItems.slice(0, 3).map((item) => (
        <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white transition hover:-translate-y-1 hover:shadow-sm">
          {item.image ? (
            <img
              src={item.image}
              alt={`${item.title} - ${item.category} di ${item.location}`}
              class="h-48 w-full object-cover"
            />
          ) : (
            <div class="flex h-48 items-center justify-center bg-gradient-to-br from-slate-200 to-slate-300">
              <span class="text-xs font-semibold uppercase tracking-[0.25em] text-slate-500">
                Image Placeholder
              </span>
            </div>
          )}

          <div class="p-6">
            <p class="text-sm font-semibold text-slate-900">
              {item.category} - {item.location}
            </p>

            <h3 class="mt-2 text-xl font-semibold text-slate-950">
              {item.title}
            </h3>

            <p class="mt-3 text-sm leading-7 text-slate-600">
              {item.description}
            </p>
          </div>
        </div>
      ))}
    </div>

    <a
      href="/portfolio"
      class="mt-8 inline-flex rounded-full border border-slate-300 px-6 py-3 text-sm font-semibold text-slate-800 transition hover:bg-white"
    >
      Lihat Semua Portfolio
    </a>
  </div>
</section>
