---
import { site } from '../data/site';

const whatsappUrl = `https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent(
  'Halo Karya Agung Interior, saya ingin cek estimasi kitchen set/kabinet custom. Berikut foto area, ukuran kasar, lokasi proyek, dan referensi yang saya suka.'
)}`;

const { variant = 'standard' } = Astro.props;
const isHomepage = variant === 'homepage';
const isServiceTeaser = variant === 'service';
const isTeaser = isHomepage || isServiceTeaser;

const homepageHighlights = [
  'Kitchen set mulai Rp2,3 juta / meter lari',
  'Custom cabinet mulai Rp2,3 juta / meter persegi',
  'Pengukuran Rp500 ribu, dipotong jika lanjut produksi',
];

const priceItems = [
  'Kitchen set custom mulai dari Rp2.300.000/meter lari',
  'Custom cabinet mulai dari Rp2.300.000/meter persegi',
  'Top table sekitar Rp2.500.000/meter',
  'LED kabinet Rp150.000/meter',
  'Laci tambahan Rp300.000/laci',
];

const includedItems = [
  'Finishing HPL Taco',
  'Bagian dalam melamin putih',
  'Engsel dan rel soft close Taco atau setara',
  'Handle minimalis, termasuk model tanpa handle atau coakan',
  'Free 3 laci untuk setiap kitchen set atau cabinet',
];

const serviceNotes = [
  'Konsultasi awal via WhatsApp gratis',
  'Desain 3D kabinet gratis',
  'Render by request, dengan waktu pengerjaan lebih lama',
  'Pengukuran lokasi Rp500.000 dan mengurangi total tagihan jika lanjut produksi',
];
---

<section id="harga" class="bg-slate-50 px-6 py-20">
  <div class="mx-auto max-w-6xl">
    {isTeaser ? (
      <div class="grid gap-8 rounded-3xl border border-slate-200 bg-white p-6 shadow-sm shadow-slate-950/5 md:p-8 lg:grid-cols-[1fr_0.9fr] lg:items-center">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.3em] text-slate-900">
            Harga Awal
          </p>

          <h2 class="mt-4 max-w-3xl text-3xl font-bold tracking-tight text-slate-950 md:text-4xl">
            Perlu gambaran budget sebelum survey?
          </h2>

          <p class="mt-5 max-w-2xl leading-8 text-slate-600">
            {isHomepage ? (
              <>
                Kami menyediakan halaman estimasi harga awal untuk kitchen set,
                kabinet custom, top table, LED, laci tambahan, dan biaya pengukuran.
              </>
            ) : (
              <>
                Kami menyediakan estimasi harga awal untuk kitchen set, kabinet
                custom, top table, LED kabinet, laci tambahan, dan biaya pengukuran.
              </>
            )}
          </p>
        </div>

        <div>
          <ul class="space-y-3 text-sm leading-7 text-slate-700">
            {homepageHighlights.map((item) => (
              <li class="flex gap-3">
                <span class="mt-3 h-2 w-2 shrink-0 rounded-full bg-slate-900"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>

          <div class="mt-6 flex flex-col gap-3 sm:flex-row">
            <a
              href="/estimasi-harga"
              class="rounded-full bg-slate-900 px-5 py-3 text-center text-sm font-semibold text-white transition hover:bg-slate-950"
            >
              Lihat Estimasi Harga
            </a>

            <a
              href={whatsappUrl}
              target="_blank"
              class="rounded-full border border-slate-300 px-5 py-3 text-center text-sm font-semibold text-slate-800 transition hover:bg-slate-50"
            >
              Cek via WhatsApp
            </a>
          </div>
        </div>
      </div>
    ) : (
      <>
        <p class="text-sm font-semibold uppercase tracking-[0.3em] text-slate-900">
          Harga Awal
        </p>

        <div class="mt-4 grid gap-8 lg:grid-cols-[1fr_0.9fr] lg:items-start">
          <div>
            <h2 class="max-w-3xl text-3xl font-bold tracking-tight text-slate-950 md:text-4xl">
              Harga awal cabinetry custom untuk gambaran budget.
            </h2>

            <p class="mt-5 max-w-2xl text-slate-600">
              Kami menyediakan estimasi awal agar Anda punya gambaran budget
              sebelum survey. Harga final tetap menyesuaikan ukuran, layout,
              material, aksesoris, top table, tingkat kesulitan, dan kondisi
              lokasi.
            </p>
          </div>

          <div class="rounded-3xl bg-slate-950 p-6 text-white md:p-8">
            <h3 class="text-xl font-semibold">Penawaran resmi setelah pengukuran.</h3>
            <p class="mt-3 leading-7 text-slate-300">
              Pengukuran membantu memastikan ukuran aktual, detail lokasi, dan
              kebutuhan aksesoris sebelum harga final diberikan.
            </p>
            <a
              href={whatsappUrl}
              target="_blank"
              class="mt-6 inline-flex rounded-full bg-white px-5 py-3 text-sm font-semibold text-slate-950 transition hover:bg-slate-100"
            >
              Cek Estimasi via WhatsApp
            </a>
          </div>
        </div>

        <div class="mt-10 grid gap-6 lg:grid-cols-3">
          <div class="rounded-3xl border border-slate-200 bg-white p-6">
            <h3 class="text-xl font-semibold text-slate-950">Estimasi Awal</h3>
            <ul class="mt-5 space-y-3 text-sm leading-7 text-slate-600">
              {priceItems.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>

          <div class="rounded-3xl border border-slate-200 bg-white p-6">
            <h3 class="text-xl font-semibold text-slate-950">Spesifikasi Dasar</h3>
            <ul class="mt-5 space-y-3 text-sm leading-7 text-slate-600">
              {includedItems.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>

          <div class="rounded-3xl border border-slate-200 bg-white p-6">
            <h3 class="text-xl font-semibold text-slate-950">Konsultasi & Survey</h3>
            <ul class="mt-5 space-y-3 text-sm leading-7 text-slate-600">
              {serviceNotes.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        </div>
      </>
    )}
  </div>
</section>
