---
import { processSteps } from '../data/process';
---

<section id="proses" class="bg-white px-6 py-20">
  <div class="mx-auto max-w-6xl">
    <p class="text-sm font-semibold uppercase tracking-[0.3em] text-slate-900">
      Proses Kerja
    </p>

    <h2 class="mt-4 max-w-3xl text-3xl font-bold tracking-tight text-slate-950 md:text-4xl">
      Proses pembuatan kabinet dari konsultasi sampai pemasangan.
    </h2>

    <p class="mt-5 max-w-2xl text-slate-600">
      Kami membuat proses pembuatan kitchen set dan kabinet custom lebih mudah
      dipahami, mulai dari kebutuhan penyimpanan, ukuran ruang, pilihan material,
      estimasi biaya, produksi, hingga pemasangan.
    </p>

    <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {processSteps.map((step) => (
        <div class="rounded-3xl border border-slate-200 bg-slate-50 p-6 transition hover:-translate-y-1 hover:bg-white hover:shadow-sm">
          <p class="text-sm font-semibold text-slate-900">{step.number}</p>
          <h3 class="mt-3 text-xl font-semibold text-slate-950">{step.title}</h3>
          <p class="mt-3 leading-7 text-slate-600">
            {step.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
