---
import { processSteps } from '../data/process';
---

<section id="proses" class="bg-white px-6 py-20">
  <div class="mx-auto max-w-6xl">
    <p class="text-sm font-semibold uppercase tracking-[0.3em] text-emerald-700">
      Proses Kerja
    </p>

    <h2 class="mt-4 max-w-3xl text-3xl font-bold tracking-tight md:text-4xl">
      Alur kerja dibuat bertahap supaya keputusan lebih rapi.
    </h2>

    <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {processSteps.map((step) => (
        <div class="rounded-3xl border border-stone-200 bg-stone-50 p-6">
          <p class="text-sm font-semibold text-emerald-700">{step.number}</p>
          <h3 class="mt-3 text-xl font-semibold">{step.title}</h3>
          <p class="mt-3 text-stone-600">
            {step.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>