---
const processSteps = [
  {
    number: '01',
    title: 'Konsultasi Awal',
    description:
      'Ceritakan kebutuhan ruang, ukuran kasar, style yang diinginkan, dan perkiraan budget agar kami bisa memahami arah pengerjaan.',
  },
  {
    number: '02',
    title: 'Survey & Pengukuran',
    description:
      'Tim melakukan pengecekan lokasi dan pengukuran detail agar desain serta produksi menyesuaikan kondisi asli di lapangan.',
  },
  {
    number: '03',
    title: 'Desain & Penyesuaian',
    description:
      'Kami bantu susun desain yang fungsional, rapi, dan realistis untuk kebutuhan harian, bukan sekadar bagus di gambar.',
  },
  {
    number: '04',
    title: 'Estimasi Biaya',
    description:
      'Biaya pekerjaan disusun berdasarkan ukuran, material, finishing, dan tingkat kesulitan pengerjaan.',
  },
  {
    number: '05',
    title: 'Produksi Workshop',
    description:
      'Setelah desain dan biaya disetujui, furniture diproduksi di workshop sesuai ukuran dan spesifikasi yang sudah disepakati.',
  },
  {
    number: '06',
    title: 'Pemasangan & Finishing',
    description:
      'Tim melakukan pemasangan di lokasi, pengecekan akhir, dan perapihan finishing sebelum pekerjaan diserahterimakan.',
  },
];
---

<section id="proses" class="bg-white px-6 py-20">
  <div class="mx-auto max-w-6xl">
    <p class="text-sm font-semibold uppercase tracking-[0.3em] text-emerald-700">
      Proses Kerja
    </p>

    <h2 class="mt-4 max-w-3xl text-3xl font-bold tracking-tight md:text-4xl">
      Alur kerja jelas dari konsultasi sampai pemasangan.
    </h2>

    <p class="mt-5 max-w-2xl text-stone-600">
      Kami membuat proses pengerjaan lebih mudah dipahami, supaya klien tahu
      apa yang sedang dikerjakan, apa yang perlu diputuskan, dan kapan setiap tahap berjalan.
    </p>

    <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {processSteps.map((step) => (
        <div class="rounded-3xl border border-stone-200 bg-stone-50 p-6 transition hover:-translate-y-1 hover:bg-white hover:shadow-sm">
          <p class="text-sm font-semibold text-emerald-700">{step.number}</p>
          <h3 class="mt-3 text-xl font-semibold">{step.title}</h3>
          <p class="mt-3 leading-7 text-stone-600">
            {step.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>