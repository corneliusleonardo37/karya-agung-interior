---
import '../styles/global.css';
import { site } from '../data/site';

const {
  title = 'Karya Agung Interior — Kitchen Set, Kabinet Custom, dan Wall Panel',
  description = 'Karya Agung Interior membantu pengerjaan kitchen set, kabinet custom, wall panel, dan interior rumah dengan proses yang jelas dari desain, produksi, hingga pemasangan.',
  canonicalPath = '/',
} = Astro.props;

const normalizedCanonicalPath =
  canonicalPath === '/' ? '/' : `/${canonicalPath.replace(/^\/+|\/+$/g, '')}`;
const canonicalUrl = `${site.url}${normalizedCanonicalPath === '/' ? '/' : normalizedCanonicalPath}`;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={site.name} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'LocalBusiness',
      name: site.name,
      description:
        'Interior design and build untuk kitchen set, kabinet custom, wall panel, dan interior rumah.',
      url: site.url,
      areaServed: site.areas,
      serviceType: [
        'Kitchen Set',
        'Custom Cabinet',
        'Wall Panel',
        'Interior Design',
        'Interior Build',
        'Custom Furniture'
      ],
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'customer service',
        telephone: `+${site.whatsappNumber}`,
        availableLanguage: ['Indonesian']
      }
    })} />
  </head>

  <body class="bg-stone-50 antialiased">
    <slot />
  </body>
</html>