---
import '../styles/global.css';
import { site } from '../data/site';

const {
  title = 'Karya Agung Interior - Kitchen Set dan Kabinet Custom',
  description = 'Jasa pembuatan kitchen set custom, kabinet custom, wardrobe, wall panel, backdrop TV, dan built-in furniture. Konsultasi WA gratis, desain 3D kabinet gratis, dan survey pengukuran tersedia.',
  keywords = 'kitchen set custom, jasa kitchen set, kitchen set BSD, kitchen set Tangerang Selatan, kabinet custom, wardrobe custom, built-in furniture, wall panel, backdrop TV, cabinetry custom',
  canonicalPath = '/',
} = Astro.props;

const trimmedCanonicalPath = canonicalPath.replace(/^\/+|\/+$/g, '');
const normalizedCanonicalPath = trimmedCanonicalPath === '' ? '/' : `/${trimmedCanonicalPath}/`;
const canonicalUrl = `${site.url}${normalizedCanonicalPath}`;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-89L3EW9MRQ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){window.dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-89L3EW9MRQ');
    </script>

    <title>{title}</title>

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={site.name} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'LocalBusiness',
      name: site.name,
      legalName: site.legalName,
      description:
        'Jasa pembuatan kitchen set custom, kabinet custom, wardrobe, wall panel, backdrop TV, dan built-in furniture.',
      url: site.url,
      areaServed: site.areas,
      serviceType: [
        'Kitchen Set Custom',
        'Custom Cabinet',
        'Wardrobe Custom',
        'Built-in Furniture',
        'Wall Panel',
        'Backdrop TV',
        'Cabinetry'
      ],
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'customer service',
        telephone: `+${site.whatsappNumber}`,
        availableLanguage: ['Indonesian']
      }
    })} />
  </head>

  <body class="bg-stone-50 antialiased">
    <slot />
  </body>
</html>
