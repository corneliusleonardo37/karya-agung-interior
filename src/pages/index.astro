---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import LayananSection from '../components/LayananSection.astro';
import SistemVerdSection from '../components/SistemVerdSection.astro';
import ProsesSection from '../components/ProsesSection.astro';
import PortfolioSection from '../components/PortfolioSection.astro';
import FAQSection from '../components/FAQSection.astro';
import FAQSchema from '../components/FAQSchema.astro';
import CTASection from '../components/CTASection.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
---

<Layout canonicalPath="/">
  <main class="min-h-screen bg-stone-50 text-stone-900">
    <Header />
    <Hero />
    <LayananSection />
    <SistemVerdSection />
    <ProsesSection />
    <PortfolioSection />
    <FAQSection />
    <FAQSchema />
    <CTASection />
    <Footer />
    <WhatsAppButton />
  </main>
</Layout>
