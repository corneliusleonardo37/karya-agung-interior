---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { site, whatsappUrl } from '../data/site';

const consultationItems = [
  'Foto area yang ingin dibuat kitchen set, kabinet, wardrobe, atau wall panel.',
  'Ukuran kasar area atau ruangan.',
  'Lokasi proyek, misalnya BSD, Serpong, Tangerang Selatan, Jakarta, Surabaya, atau Sidoarjo.',
  'Jenis kabinet yang dibutuhkan.',
  'Referensi desain dari Pinterest, Instagram, katalog, render, atau foto kabinet.',
  'Perkiraan budget dan kebutuhan aksesoris seperti top table, laci, LED, atau aksesoris tambahan.',
];
---

<Layout
  title="Kontak Karya Agung Interior - Konsultasi Kitchen Set dan Kabinet Custom"
  description="Hubungi Karya Agung Interior untuk konsultasi kitchen set custom, kabinet custom, wardrobe, wall panel, backdrop TV, dan built-in furniture."
  canonicalPath="/kontak"
>
  <main class="min-h-screen bg-slate-50 text-slate-950">
    <Header />

    <section class="mx-auto max-w-6xl px-6 pb-20 pt-32">
      <p class="text-sm font-semibold uppercase tracking-[0.3em] text-slate-900">
        Kontak Karya Agung Interior
      </p>

      <h1 class="mt-4 max-w-4xl text-4xl font-bold leading-tight tracking-tight text-slate-950 md:text-6xl">
        Konsultasikan kitchen set atau kabinet custom Anda.
      </h1>

      <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600">
        Mulai dari konsultasi singkat via WhatsApp. Kirim foto area, ukuran
        kasar, lokasi proyek, referensi desain, dan perkiraan budget. Kami bantu
        cek kebutuhan dan estimasi awal sebelum survey.
      </p>
    </section>

    <section class="bg-white px-6 py-20">
      <div class="mx-auto grid max-w-6xl gap-8 md:grid-cols-2">
        <div class="rounded-3xl border border-slate-200 bg-slate-50 p-8">
          <h2 class="text-2xl font-bold text-slate-950">Hubungi Kami</h2>

          <div class="mt-6 space-y-4 text-slate-600">
            <p>
              <span class="font-semibold text-slate-950">WhatsApp:</span>
              {site.whatsappDisplay}
            </p>

            <p>
              <span class="font-semibold text-slate-950">Instagram:</span>
              {site.instagram}
            </p>

            <p>
              <span class="font-semibold text-slate-950">Email:</span>
              {site.email}
            </p>
          </div>

          <p class="mt-6 leading-8 text-slate-600">
            Konsultasi awal via WhatsApp gratis. Penawaran resmi baru diberikan
            setelah pengukuran lokasi.
          </p>

          <a
            href={whatsappUrl}
            target="_blank"
            class="mt-8 inline-flex rounded-full bg-slate-900 px-6 py-3 text-sm font-semibold text-white transition hover:bg-slate-950"
          >
            Konsultasi via WhatsApp
          </a>
        </div>

        <div class="rounded-3xl border border-slate-200 bg-slate-50 p-8">
          <h2 class="text-2xl font-bold text-slate-950">Area Layanan</h2>

          <ul class="mt-6 grid gap-3 text-slate-600 sm:grid-cols-2">
            {site.areas.map((area) => (
              <li class="rounded-2xl bg-white px-4 py-3">
                {area}
              </li>
            ))}
          </ul>

          <p class="mt-6 leading-8 text-slate-600">
            Untuk area lain di sekitar lokasi layanan, kebutuhan kabinet bisa
            dibahas terlebih dahulu melalui konsultasi awal.
          </p>
        </div>
      </div>
    </section>

    <section class="bg-slate-50 px-6 py-20">
      <div class="mx-auto max-w-4xl rounded-3xl bg-slate-950 p-8 text-white md:p-12">
        <p class="text-sm font-semibold uppercase tracking-[0.3em] text-slate-300">
          Sebelum Konsultasi
        </p>

        <h2 class="mt-4 text-3xl font-bold tracking-tight md:text-4xl">
          Siapkan data sederhana untuk estimasi awal.
        </h2>

        <p class="mt-5 max-w-3xl leading-8 text-slate-300">
          Agar estimasi awal lebih mudah dihitung, Anda bisa menyiapkan beberapa
          informasi berikut sebelum menghubungi kami.
        </p>

        <ol class="mt-8 grid gap-x-8 gap-y-5 text-sm leading-7 text-slate-300 md:grid-cols-2">
          {consultationItems.map((item, index) => (
            <li class="flex gap-4">
              <span class="font-semibold text-white">{index + 1}.</span>
              <span>{item}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <Footer />

    <WhatsAppButton />
  </main>
</Layout>
