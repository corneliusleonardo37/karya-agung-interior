---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import CTASection from '../components/CTASection.astro';
import { services } from '../data/services';
---

<Layout
  title="Layanan Karya Agung Interior — Kitchen Set, Kabinet Custom, dan Wall Panel"
  description="Layanan Karya Agung Interior meliputi kitchen set, kabinet custom, wall panel, backdrop TV, interior rumah, apartemen, dan usaha kecil."
  canonicalPath="/layanan"
>
  <main class="min-h-screen bg-stone-50 text-stone-900">
    <Header />

    <section class="mx-auto max-w-6xl px-6 pb-20 pt-32">
      <p class="text-sm font-semibold uppercase tracking-[0.3em] text-emerald-700">
        Layanan Karya Agung Interior
      </p>

      <h1 class="mt-4 max-w-4xl text-4xl font-bold leading-tight tracking-tight md:text-6xl">
        Layanan interior untuk rumah yang lebih rapi dan fungsional.
      </h1>

      <p class="mt-6 max-w-2xl text-lg leading-8 text-stone-600">
        Kami membantu pengerjaan kitchen set, kabinet custom, wall panel,
        backdrop TV, interior apartemen, dan kebutuhan furniture custom lainnya.
      </p>
    </section>

    <section class="bg-white px-6 py-20">
      <div class="mx-auto max-w-6xl">
        <div class="grid gap-6 md:grid-cols-2">
          {services.map((service) => (
            <div class="rounded-3xl border border-stone-200 bg-stone-50 p-8 transition hover:-translate-y-1 hover:bg-white hover:shadow-sm">
              <h2 class="text-2xl font-bold">{service.title}</h2>
              <p class="mt-4 leading-8 text-stone-600">
                {service.description}
              </p>

              <div class="mt-6 rounded-2xl bg-white p-5 text-sm leading-7 text-stone-600">
                Pekerjaan dapat disesuaikan dengan ukuran ruang, kebutuhan penyimpanan,
                pilihan material, finishing, dan budget yang tersedia.
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-stone-50 px-6 py-20">
      <div class="mx-auto max-w-6xl">
        <p class="text-sm font-semibold uppercase tracking-[0.3em] text-emerald-700">
          Catatan
        </p>

        <h2 class="mt-4 max-w-3xl text-3xl font-bold tracking-tight md:text-4xl">
          Tidak harus mulai dari proyek interior besar.
        </h2>

        <p class="mt-5 max-w-3xl leading-8 text-stone-600">
          Anda bisa mulai dari satu area dulu, seperti kitchen set, kabinet TV,
          lemari kamar, wall panel, atau storage tambahan. Kami bantu susun pilihan
          yang paling masuk akal sesuai kebutuhan dan kondisi ruang.
        </p>
      </div>
    </section>

    <CTASection />

    <Footer />

    <WhatsAppButton />
  </main>
</Layout>