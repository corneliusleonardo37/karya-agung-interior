---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import CTASection from '../components/CTASection.astro';
import { services } from '../data/services';
---

<Layout
  title="Layanan Verd — Design & Build Interior Transparan"
  description="Layanan Verd meliputi interior design, design & build, project management, RAB, interior fit-out, dan custom furniture."
>
  <main class="min-h-screen bg-stone-50 text-stone-900">
    <Header />

    <section class="mx-auto max-w-6xl px-6 pb-20 pt-32">
      <p class="text-sm font-semibold uppercase tracking-[0.3em] text-emerald-700">
        Layanan Verd
      </p>

      <h1 class="mt-4 max-w-4xl text-4xl font-bold leading-tight tracking-tight md:text-6xl">
        Layanan desain, build, dan pengelolaan proyek interior.
      </h1>

      <p class="mt-6 max-w-2xl text-lg leading-8 text-stone-600">
        Verd membantu klien merencanakan, mendesain, dan mengeksekusi interior dengan proses
        yang lebih jelas, bertahap, dan terukur.
      </p>
    </section>

    <section class="bg-white px-6 py-20">
      <div class="mx-auto max-w-6xl">
        <div class="grid gap-6 md:grid-cols-2">
          {services.map((service) => (
            <div class="rounded-3xl border border-stone-200 bg-stone-50 p-8">
              <h2 class="text-2xl font-bold">{service.title}</h2>
              <p class="mt-4 leading-8 text-stone-600">
                {service.description}
              </p>

              <div class="mt-6 rounded-2xl bg-white p-5 text-sm leading-7 text-stone-600">
                Layanan ini dapat disesuaikan dengan kebutuhan proyek, kondisi ruang,
                target budget, dan prioritas pekerjaan.
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-stone-50 px-6 py-20">
      <div class="mx-auto max-w-6xl">
        <p class="text-sm font-semibold uppercase tracking-[0.3em] text-emerald-700">
          Catatan
        </p>

        <h2 class="mt-4 max-w-3xl text-3xl font-bold tracking-tight md:text-4xl">
          Setiap proyek tidak harus dimulai dari paket besar.
        </h2>

        <p class="mt-5 max-w-3xl leading-8 text-stone-600">
          Kamu bisa mulai dari konsultasi, desain, perencanaan biaya, atau pengelolaan proyek
          sesuai kebutuhan. Verd membantu menyusun langkah yang paling masuk akal sebelum
          pekerjaan dijalankan.
        </p>
      </div>
    </section>

    <CTASection />

    <Footer />

    <WhatsAppButton />
  </main>
</Layout>