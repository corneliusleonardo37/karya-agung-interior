---
import Layout from '../layouts/Layout.astro';
import { linkItems } from '../data/links';
import { site } from '../data/site';
---

<Layout
  title="Links Verd — Design & Build Interior"
  description="Temukan link penting Verd untuk konsultasi WhatsApp, sistem Verd, dan Instagram."
  canonicalPath="/links"
>
  <main class="min-h-screen bg-white px-6 py-10 text-stone-900">
    <section class="mx-auto flex min-h-screen max-w-xl flex-col justify-center">
      <div class="rounded-[2rem] border border-stone-200 bg-white p-6 shadow-xl">
        <div class="text-center">
          <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-3xl bg-emerald-700 text-3xl font-bold text-white shadow-lg">
            V
          </div>

          <p class="mx-auto mt-6 max-w-sm text-sm leading-7 text-stone-600">
            Design & build interior dengan proses biaya, desain, dan pelaksanaan
            yang lebih jelas dan terkelola.
          </p>
        </div>

        <div class="mt-8 space-y-4">
          {linkItems.map((item) => (
            <a
              href={item.href}
              target={item.href.startsWith('http') ? '_blank' : '_self'}
              rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              class:list={[
                'block rounded-3xl border p-5 transition',
                item.isPrimary
                  ? 'border-emerald-700 bg-emerald-700 text-white hover:bg-emerald-800'
                  : 'border-stone-200 bg-stone-50 hover:bg-stone-100',
              ]}
            >
              <div class="flex items-start justify-between gap-4">
                <div>
                  <h2 class={item.isPrimary ? 'font-semibold text-white' : 'font-semibold text-stone-900'}>
                    {item.title}
                  </h2>

                  <p class:list={[
                    'mt-2 text-sm leading-6',
                    item.isPrimary ? 'text-emerald-50/90' : 'text-stone-600',
                  ]}>
                    {item.description}
                  </p>
                </div>

                <span class={item.isPrimary ? 'mt-1 text-lg text-white' : 'mt-1 text-lg text-stone-500'}>
                  →
                </span>
              </div>
            </a>
          ))}
        </div>

        <div class="mt-8 border-t border-stone-200 pt-6 text-center">
          <p class="text-xs leading-6 text-stone-500">
            Area layanan: {site.areas.join(', ')}
          </p>

          <p class="mt-2 text-xs text-stone-400">
            © 2026 {site.name}. All rights reserved.
          </p>
        </div>
      </div>
    </section>
  </main>
</Layout>