---
import Layout from '../layouts/Layout.astro';
import { linkItems } from '../data/links';
import { site } from '../data/site';
---

<Layout
  title="Links Verd — Design & Build Interior"
  description="Temukan link penting Verd untuk konsultasi WhatsApp, layanan, sistem Verd, portfolio, kontak, dan Instagram."
>
  <main class="min-h-screen bg-stone-950 px-6 py-10 text-white">
    <section class="mx-auto flex min-h-screen max-w-xl flex-col justify-center">
      <div class="text-center">
        <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-emerald-700 text-2xl font-bold">
          V
        </div>

        <h1 class="mt-6 text-3xl font-bold">
          {site.name}
        </h1>

        <p class="mt-3 text-sm leading-7 text-stone-300">
          Design & build interior dengan proses biaya, desain, dan pelaksanaan
          yang lebih jelas dan terkelola.
        </p>
      </div>

      <div class="mt-8 space-y-4">
        {linkItems.map((item) => (
          <a
            href={item.href}
            target={item.href.startsWith('http') ? '_blank' : '_self'}
            class="block rounded-3xl border border-white/10 bg-white/10 p-5 transition hover:bg-white/15"
          >
            <h2 class="font-semibold text-white">
              {item.title}
            </h2>

            <p class="mt-2 text-sm leading-6 text-stone-300">
              {item.description}
            </p>
          </a>
        ))}
      </div>

      <p class="mt-8 text-center text-xs text-stone-500">
        © 2026 {site.name}. All rights reserved.
      </p>
    </section>
  </main>
</Layout>