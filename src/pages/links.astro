---
import Layout from '../layouts/Layout.astro';
import { linkItems } from '../data/links';
import { site } from '../data/site';
---

<Layout
  title="Links Karya Agung Interior — Kitchen Set, Kabinet Custom, dan Wall Panel"
  description="Link penting Karya Agung Interior untuk konsultasi WhatsApp, portfolio, Instagram, dan website utama."
  canonicalPath="/link"
>
  <main class="min-h-screen bg-slate-50 px-6 py-10 text-slate-950">
    <section class="mx-auto flex min-h-screen max-w-xl flex-col justify-center">
      <div class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-xl shadow-slate-950/10">
        <div class="text-center">
          <img
            src="/karya-agung-logo.svg"
            alt="Karya Agung Interior logo"
            class="mx-auto mt-6 h-20 w-auto"
          />

          <p class="mx-auto mt-3 max-w-sm text-sm leading-7 text-slate-600">
            Spesialis kitchen set, kabinet custom dan wall panel untuk interior
            yang rapi, fungsional, dan nyaman digunakan.
          </p>
        </div>

        <div class="mt-8 space-y-4">
          {linkItems.map((item) => (
            <a
              href={item.href}
              target={item.href.startsWith('http') ? '_blank' : '_self'}
              rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              class:list={[
                'block rounded-3xl border p-5 transition hover:-translate-y-0.5',
                item.isPrimary
                  ? 'border-slate-900 bg-slate-900 text-white shadow-lg shadow-slate-950/20 hover:bg-slate-950'
                  : 'border-slate-200 bg-slate-50 hover:border-slate-300 hover:bg-white hover:shadow-sm',
              ]}
            >
              <div class="flex items-start justify-between gap-4">
                <div>
                  <h2 class={item.isPrimary ? 'font-semibold text-white' : 'font-semibold text-slate-950'}>
                    {item.title}
                  </h2>

                  <p class:list={[
                    'mt-2 text-sm leading-6',
                    item.isPrimary ? 'text-slate-300' : 'text-slate-600',
                  ]}>
                    {item.description}
                  </p>
                </div>

                <span class={item.isPrimary ? 'mt-1 text-lg text-white' : 'mt-1 text-lg text-slate-500'}>
                  →
                </span>
              </div>
            </a>
          ))}
        </div>

        <div class="mt-8 border-t border-slate-200 pt-6 text-center">
          <p class="text-xs leading-6 text-slate-500">
            Area layanan: {site.areas.join(', ')}
          </p>

          <p class="mt-2 text-xs text-slate-400">
            © 2026 {site.name}. All rights reserved.
          </p>
        </div>
      </div>
    </section>
  </main>
</Layout>