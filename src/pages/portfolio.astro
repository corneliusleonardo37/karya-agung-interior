---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import CTASection from '../components/CTASection.astro';
import { portfolioItems } from '../data/portfolio';
---

<Layout
  title="Portfolio Karya Agung Interior - Kitchen Set, Kabinet Custom, dan Built-in Furniture"
  description="Lihat contoh pengerjaan kitchen set, kabinet custom, wardrobe, wall panel, backdrop TV, built-in furniture, dan kabinet display Karya Agung Interior."
  canonicalPath="/portfolio"
>
  <main class="min-h-screen bg-stone-50 text-stone-900">
    <Header />

    <section class="mx-auto max-w-6xl px-6 pb-20 pt-32">
      <p class="text-sm font-semibold uppercase tracking-[0.3em] text-slate-900">
        Portfolio Karya Agung Interior
      </p>

      <h1 class="mt-4 max-w-4xl text-4xl font-bold leading-tight tracking-tight md:text-6xl">
        Portfolio kitchen set, kabinet custom, dan built-in furniture.
      </h1>

      <p class="mt-6 max-w-2xl text-lg leading-8 text-stone-600">
        Beberapa contoh pekerjaan kami meliputi kitchen set, kabinet storage,
        wardrobe, backdrop TV, wall panel, dan kabinet display yang dibuat
        menyesuaikan ukuran ruang.
      </p>
    </section>

    <section class="bg-white px-6 py-20">
      <div class="mx-auto max-w-6xl">
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {portfolioItems.map((item) => (
            <article class="overflow-hidden rounded-3xl border border-stone-200 bg-stone-50 transition hover:-translate-y-1 hover:shadow-sm">
              {item.image ? (
                <img
                  src={item.image}
                  alt={`${item.title} - ${item.category} di ${item.location}`}
                  class="h-64 w-full object-cover"
                />
              ) : (
                <div class="flex h-64 items-center justify-center bg-gradient-to-br from-stone-200 to-stone-300">
                  <span class="text-sm font-semibold uppercase tracking-[0.25em] text-stone-500">
                    Image Placeholder
                  </span>
                </div>
              )}

              <div class="p-6">
                <p class="text-sm font-semibold text-slate-900">
                  {item.category} - {item.location}
                </p>

                <h2 class="mt-3 text-2xl font-bold">
                  {item.title}
                </h2>

                <p class="mt-4 leading-7 text-stone-600">
                  {item.description}
                </p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-stone-50 px-6 py-20">
      <div class="mx-auto max-w-6xl">
        <div class="rounded-3xl border border-stone-200 bg-white p-8 md:p-12">
          <p class="text-sm font-semibold uppercase tracking-[0.3em] text-slate-900">
            Catatan Portfolio
          </p>

          <h2 class="mt-4 max-w-3xl text-3xl font-bold tracking-tight md:text-4xl">
            Portfolio akan diperkuat dengan foto hasil, proses produksi, dan detail kabinet.
          </h2>

          <p class="mt-5 max-w-3xl leading-8 text-stone-600">
            Setiap portfolio sebaiknya berisi nama proyek, lokasi, jenis kabinet,
            kebutuhan penyimpanan, material utama, detail finishing, dan dokumentasi
            visual sebelum-sesudah jika tersedia.
          </p>
        </div>
      </div>
    </section>

    <CTASection />

    <Footer />

    <WhatsAppButton />
  </main>
</Layout>
