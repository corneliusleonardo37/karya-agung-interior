---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import CTASection from '../components/CTASection.astro';
import { processSteps } from '../data/process';

const paymentSteps = [
  {
    title: 'Biaya Pengukuran',
    description:
      'Biaya pengukuran Rp500.000 dan akan mengurangi total tagihan jika klien lanjut produksi.',
  },
  {
    title: 'Termin 1 - 50%',
    description:
      'Dibayarkan untuk memulai produksi setelah desain 3D kabinet, spesifikasi, dan penawaran disetujui.',
  },
  {
    title: 'Termin 2 - 45%',
    description:
      'Dibayarkan sebelum pengiriman dan pemasangan kabinet ke lokasi.',
  },
  {
    title: 'Pelunasan - 5%',
    description:
      'Dibayarkan setelah pekerjaan selesai dicek bersama dan serah terima dilakukan.',
  },
];
---

<Layout
  title="Proses Kerja Karya Agung Interior - Kitchen Set dan Kabinet Custom"
  description="Pelajari proses pembuatan kitchen set dan kabinet custom dari konsultasi WhatsApp, survey, pengukuran, desain 3D kabinet, penawaran resmi, produksi workshop, hingga pemasangan."
  canonicalPath="/proses"
>
  <main class="min-h-screen bg-stone-50 text-stone-900">
    <Header />

    <section class="mx-auto max-w-6xl px-6 pb-20 pt-32">
      <p class="text-sm font-semibold uppercase tracking-[0.3em] text-slate-900">
        Proses Kerja
      </p>

      <h1 class="mt-4 max-w-4xl text-4xl font-bold leading-tight tracking-tight md:text-6xl">
        Proses pembuatan kabinet yang jelas dari konsultasi sampai pemasangan.
      </h1>

      <p class="mt-6 max-w-2xl text-lg leading-8 text-stone-600">
        Kami membantu klien memahami setiap tahap pengerjaan kitchen set,
        wardrobe, kabinet custom, wall panel, dan built-in furniture agar
        keputusan lebih jelas sebelum produksi dimulai.
      </p>
    </section>

    <section class="bg-white px-6 py-20">
      <div class="mx-auto grid max-w-6xl gap-6 md:grid-cols-2 lg:grid-cols-3">
        {processSteps.map((step) => (
          <div class="rounded-3xl border border-stone-200 bg-stone-50 p-6">
            <p class="text-sm font-semibold text-slate-900">{step.number}</p>
            <h2 class="mt-3 text-xl font-semibold">{step.title}</h2>
            <p class="mt-3 leading-7 text-stone-600">
              {step.description}
            </p>
          </div>
        ))}
      </div>
    </section>

    <section class="bg-stone-50 px-6 py-20">
      <div class="mx-auto max-w-6xl">
        <p class="text-sm font-semibold uppercase tracking-[0.3em] text-slate-900">
          Harga & Pembayaran
        </p>

        <h2 class="mt-4 max-w-3xl text-3xl font-bold tracking-tight md:text-4xl">
          Pembayaran bertahap agar proses produksi tetap jelas.
        </h2>

        <p class="mt-5 max-w-3xl leading-8 text-stone-600">
          Konsultasi awal via WhatsApp dan desain 3D kabinet gratis. Penawaran
          resmi baru diberikan setelah pengukuran, karena harga final mengikuti
          ukuran, layout, material, aksesoris, top table, tingkat kesulitan, dan
          kondisi lokasi.
        </p>

        <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
          {paymentSteps.map((item) => (
            <div class="rounded-3xl border border-stone-200 bg-white p-6">
              <h3 class="text-xl font-semibold text-stone-950">{item.title}</h3>
              <p class="mt-3 leading-7 text-stone-600">
                {item.description}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <CTASection />

    <Footer />

    <WhatsAppButton />
  </main>
</Layout>
