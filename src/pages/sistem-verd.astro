---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import CTASection from '../components/CTASection.astro';
import { systemValues } from '../data/system';
---

<Layout
  title="Sistem Verd — Open-Book Design & Build Interior"
  description="Sistem Verd membantu klien menjalankan proyek interior dengan struktur biaya yang lebih transparan, fee jelas, laporan progres, dan proses kerja yang lebih terkelola."
>
  <main class="min-h-screen bg-stone-50 text-stone-900">
    <Header />

    <section class="mx-auto max-w-6xl px-6 pb-20 pt-32">
      <p class="text-sm font-semibold uppercase tracking-[0.3em] text-emerald-700">
        Sistem Verd
      </p>

      <h1 class="mt-4 max-w-4xl text-4xl font-bold leading-tight tracking-tight md:text-6xl">
        Sistem design & build yang lebih terbuka dan terkelola.
      </h1>

      <p class="mt-6 max-w-2xl text-lg leading-8 text-stone-600">
        Verd memakai pendekatan yang lebih transparan dalam perencanaan biaya, desain,
        eksekusi, dan laporan proyek. Tujuannya sederhana: klien lebih paham uangnya
        dipakai untuk apa, pekerjaan berjalan ke mana, dan keputusan diambil berdasarkan data.
      </p>
    </section>

    <section class="bg-white px-6 py-20">
      <div class="mx-auto max-w-6xl">
        <div class="grid gap-6 md:grid-cols-3">
          {systemValues.map((item) => (
            <div class="rounded-3xl border border-stone-200 bg-stone-50 p-8">
              <h2 class="text-2xl font-bold">{item.title}</h2>
              <p class="mt-4 leading-8 text-stone-600">
                {item.description}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-stone-50 px-6 py-20">
      <div class="mx-auto max-w-6xl">
        <p class="text-sm font-semibold uppercase tracking-[0.3em] text-emerald-700">
          Cara Kerja Sistem
        </p>

        <h2 class="mt-4 max-w-3xl text-3xl font-bold tracking-tight md:text-4xl">
          Verd tidak mengambil margin dari kebingungan klien.
        </h2>

        <div class="mt-10 grid gap-6 md:grid-cols-2">
          <div class="rounded-3xl border border-stone-200 bg-white p-8">
            <h3 class="text-xl font-semibold">Open-book</h3>
            <p class="mt-4 leading-8 text-stone-600">
              Struktur biaya proyek dibuat lebih terbuka agar klien dapat memahami komponen
              biaya, prioritas pekerjaan, dan arah penggunaan budget.
            </p>
          </div>

          <div class="rounded-3xl border border-stone-200 bg-white p-8">
            <h3 class="text-xl font-semibold">Fee yang jelas</h3>
            <p class="mt-4 leading-8 text-stone-600">
              Verd mengambil fee desain dan/atau manajemen proyek secara jelas, bukan dari
              markup tersembunyi yang sulit dilacak.
            </p>
          </div>

          <div class="rounded-3xl border border-stone-200 bg-white p-8">
            <h3 class="text-xl font-semibold">Budget tracking</h3>
            <p class="mt-4 leading-8 text-stone-600">
              Pengeluaran proyek dapat dipantau berdasarkan item pekerjaan, prioritas, dan
              kebutuhan yang sudah disetujui.
            </p>
          </div>

          <div class="rounded-3xl border border-stone-200 bg-white p-8">
            <h3 class="text-xl font-semibold">Laporan progres</h3>
            <p class="mt-4 leading-8 text-stone-600">
              Progres pekerjaan, dokumentasi, dan catatan proyek dirapikan agar komunikasi
              antara klien dan tim lebih sehat.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-white px-6 py-20">
      <div class="mx-auto max-w-6xl">
        <div class="rounded-3xl bg-emerald-950 p-8 text-white md:p-12">
          <p class="text-sm font-semibold uppercase tracking-[0.3em] text-emerald-200">
            Prinsip Verd
          </p>

          <h2 class="mt-4 max-w-3xl text-3xl font-bold tracking-tight md:text-4xl">
            Transparan bukan berarti asal murah.
          </h2>

          <p class="mt-5 max-w-3xl leading-8 text-emerald-50/80">
            Transparan berarti keputusan proyek dibuat lebih sadar: tahu prioritas, tahu
            batas budget, tahu risiko, dan tahu konsekuensi perubahan. Verd tidak menjanjikan
            proyek paling murah, tapi berusaha membuat prosesnya lebih jelas dan masuk akal.
          </p>
        </div>
      </div>
    </section>

    <CTASection />

    <Footer />

    <WhatsAppButton />
  </main>
</Layout>